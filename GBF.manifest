<?xml version="1.0" encoding="utf-8"?>
<!-- Embedded into GBF.exe by build.cmd. The settings window runs system-DPI-aware (crisp text,
     WinForms scales by font); launch/resize/record switch their thread to per-monitor v2 so that
     window coordinates are physical pixels. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="GBF.exe"/>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
    </windowsSettings>
  </application>
</assembly>
